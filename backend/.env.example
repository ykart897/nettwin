# Optional OpenCellID CSV or CSV.GZ database export.
OPENCELLID_CSV_PATH=C:\data\opencellid\cell_towers.csv.gz

# Optional comma-separated public RIPE Atlas ping measurement IDs.
# When empty, NetTwin discovers a small set of ongoing public ping measurements.
RIPE_ATLAS_MEASUREMENT_IDS=

# Local HTTP measurement agent.
LOCAL_AGENT_ID=local-pc
LOCAL_AGENT_NAME=NetTwin Local Agent
LOCAL_AGENT_LAT=41.0082
LOCAL_AGENT_LON=28.9784
LOCAL_AGENT_TARGETS=https://www.cloudflare.com/cdn-cgi/trace,https://www.google.com/generate_204
LOCAL_AGENT_DOWNLOAD_URL=https://speed.cloudflare.com/__down?bytes=250000

# Set to 1 for tests or manual-only synchronization.
NETTWIN_DISABLE_SCHEDULER=0

# Process-level server settings. start.ps1 sets NETTWIN_HOST automatically.
NETTWIN_PORT=8000
NETTWIN_RELOAD=1

# Optional calibrated load model produced by scripts.calibrate_load_model.
NETTWIN_LOAD_MODEL_PATH=

# Optional protection for operator/mutating endpoints.
NETTWIN_OPERATOR_API_KEY=

# Optional raw observation retention. Zero keeps all observations.
OBSERVATION_RETENTION_DAYS=0
